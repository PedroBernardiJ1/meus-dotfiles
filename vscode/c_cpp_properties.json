{
  "configurations": [
    {
      "name": "linux-gcc-x64",
      // Gerado pela task "ROS: build (Debug)" (o arquivo só existe depois do primeiro build)
      "compileCommands": "${workspaceFolder}/.vscode/compile_commands.json",
      // Fallback para arquivos fora do compile_commands (ex.: headers). Sem build/ e log/ de propósito.
      "includePath": [
        "${workspaceFolder}/src/**",
        "${workspaceFolder}/install/**",
        "/opt/ros/jazzy/include/**"
      ],
      "compilerPath": "/usr/bin/gcc",
      "cStandard": "${default}",
      "cppStandard": "c++17",
      "intelliSenseMode": "linux-gcc-x64"
    }
  ],
  "version": 4
}
